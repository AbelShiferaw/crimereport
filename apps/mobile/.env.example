# Copy this to .env and fill in your values

# Mapbox — get your token at https://account.mapbox.com/
MAPBOX_ACCESS_TOKEN=pk.your_mapbox_public_token_here

# Backend API — the deployed ALB URL (omit for localhost:3000 default)
API_BASE_URL=http://crimereport-alb-822016960.us-east-1.elb.amazonaws.com

# WebSocket — same host as API (omit for ws://localhost:3000 default)
WS_BASE_URL=ws://crimereport-alb-822016960.us-east-1.elb.amazonaws.com
